{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-fresh/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-seo/types/**/*.ts",
    ".next-seo2/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "pkg-tmp",
    "npm-cache-tmp",
    "scripts",
    "_next_old_142138",
    "_next_old_121217",
    "_next_old_121306",
    "_next_old_cache",
    ".next_backup_0",
    ".next-dev-bak",
    ".next-old"
  ]
}
