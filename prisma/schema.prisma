// Prisma Schema for Qianfan Website
// Datasource: SQLite (dev) / PostgreSQL (prod)
// Note: SQLite does not support enums, using String with documented values

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== Models ====================

/// Product series (7 records): Wall Sliding Rack, Drawer Cabinet, etc.
model Series {
  id          Int      @id @default(autoincrement())
  name        String
  nameCn      String?
  slug        String   @unique
  prefix      String
  description String?
  image       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    Product[]

  @@index([slug])
}

/// Product SKU (55 records): CT-001, CC-002, SG-601, etc.
model Product {
  id                  Int            @id @default(autoincrement())
  sku                 String         @unique
  seriesId            Int
  name                String
  description         String?
  standSize           String?
  panelSize           String?
  panelThickness      String?
  packageSize         String?
  numberOfPanel       Int?
  adjustablePanelSize String?
  weight              String?
  material            String?
  features            String?
  isFeatured          Boolean        @default(false)
  isPublished         Boolean        @default(true)
  sortOrder           Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  series              Series         @relation(fields: [seriesId], references: [id])
  images              ProductImage[]
  inquiries           Inquiry[]

  @@index([seriesId])
  @@index([sku])
  @@index([isPublished])
}

/// Product images with sort order and primary flag.
model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// Customer inquiry (RFQ) submitted from the website.
/// status values: NEW | CONTACTED | QUOTED | NEGOTIATING | WON | LOST
model Inquiry {
  id            Int      @id @default(autoincrement())
  inquiryNo     String   @unique
  customerName  String
  email         String
  phone         String?
  company       String?
  country       String?
  productId     Int?
  productSku    String?
  quantity      Int?
  message       String
  source        String?
  status        String   @default("NEW")
  assignedTo    String?
  chatSessionId Int?
  customerId    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product?  @relation(fields: [productId], references: [id])
  customer      Customer? @relation(fields: [customerId], references: [id])
  followUps     FollowUp[]

  @@index([status])
  @@index([email])
  @@index([customerId])
}

/// Customer record (deduplicated by email).
/// tag values: BRAND_BUYER | DESIGNER | DISTRIBUTOR | OTHER
/// status values: LEAD | ACTIVE | INACTIVE
model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  company   String?
  country   String?
  address   String?
  tag       String   @default("OTHER")
  status    String   @default("LEAD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  inquiries Inquiry[]
  followUps FollowUp[]

  @@index([email])
  @@index([status])
}

/// Follow-up record for a customer or inquiry.
/// type values: EMAIL | PHONE | MEETING | OTHER
model FollowUp {
  id                Int       @id @default(autoincrement())
  customerId        Int?
  inquiryId         Int?
  type              String    @default("EMAIL")
  content           String
  nextFollowUpDate  DateTime?
  createdBy         String?
  createdAt         DateTime  @default(now())
  customer          Customer? @relation(fields: [customerId], references: [id])
  inquiry           Inquiry?  @relation(fields: [inquiryId], references: [id])

  @@index([customerId])
  @@index([inquiryId])
}

/// Admin user for the backend management system.
/// role values: ADMIN | EDITOR | SALES
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Chat session for AI customer service.
/// status values: ACTIVE | ENDED | TRANSFERRED
model ChatSession {
  id         Int           @id @default(autoincrement())
  sessionId  String        @unique
  customerId Int?
  country    String?
  userAgent  String?
  status     String        @default("ACTIVE")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  messages   ChatMessage[]

  @@index([sessionId])
  @@index([status])
}

/// Individual chat message within a session.
/// role values: USER | ASSISTANT | SYSTEM
model ChatMessage {
  id        Int         @id @default(autoincrement())
  sessionId Int
  role      String
  content   String
  metadata  String?
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// Customer testimonial for the homepage.
model Testimonial {
  id           Int      @id @default(autoincrement())
  customerName String
  company      String?
  country      String?
  rating       Int      @default(5)
  content      String
  isPublished  Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([isPublished])
}

/// Project/case study showcase.
model Project {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String?
  content     String?
  location    String?
  projectDate DateTime?
  images      String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
}

/// Homepage banner/carousel slide.
model Banner {
  id         Int      @id @default(autoincrement())
  title      String
  subtitle   String?
  image      String
  link       String?
  sortOrder  Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isPublished])
}

/// CMS-managed page content (About Us, Contact, etc.).
model ContentPage {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  title           String
  content         String?
  metaTitle       String?
  metaDescription String?
  updatedAt       DateTime @updatedAt
}

/// Region configuration for GEO-based content.
model Region {
  id              Int     @id @default(autoincrement())
  code            String  @unique
  name            String
  defaultLanguage String  @default("en")
  phone           String?
  email           String?
  timezone        String?
  isDefault       Boolean @default(false)
}

/// Frequently Asked Questions for AI chat and FAQ page.
model FAQ {
  id        Int    @id @default(autoincrement())
  category String
  question  String
  answer    String
  keywords  String?
  sortOrder Int    @default(0)

  @@index([category])
}

/// Key-value store for site-wide settings (company info, SMTP, AI config, etc.).
model SiteSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

/// Tracking event for visitor behavior analytics.
model TrackingEvent {
  id         Int      @id @default(autoincrement())
  sessionId  String?
  customerId Int?
  eventType  String
  pageUrl    String?
  productId  Int?
  searchData String?
  duration   Int?
  country    String?
  createdAt  DateTime @default(now())

  @@index([sessionId])
  @@index([customerId])
  @@index([eventType])
}
