%% Class Diagram: Product Listing UX Optimization
%% Source: docs/ARCH-ProductListing-UX.md

classDiagram
    class ParentCategory {
        +string slug
        +string name
        +string nameCn
        +string description
        +string icon
        +string? heroImage
    }

    class SeriesInfo {
        +string slug
        +string name
        +string nameCn
        +string prefix
        +string description
        +string shortDescription
        +string icon
        +string? heroImage
        +string? parentSlug
        +string? parentName
    }

    class SeriesHelpers {
        <<module functions>>
        +isParentSlug(slug: string) boolean
        +getParentCategory(slug: string) ParentCategory?
        +getChildSeries(parentSlug: string) SeriesInfo[]
    }

    class ParentCategoryViewProps {
        +string parentSlug
        +string locale
    }

    class ParentCategoryView {
        <<React Component>>
        +ParentCategoryViewProps props
        render() JSX.Element
    }

    class ProjectCardProps {
        +ProjectWithImages project
        +string locale
    }

    class ProjectCard {
        <<React Component>>
        +ProjectCardProps props
        render() JSX.Element
    }

    class ProjectWithImages {
        +number id
        +string title
        +string slug
        +string? description
        +string? location
        +string? projectDate
        +string[] images
        +boolean isPublished
    }

    class SpecFinderResult {
        +Product product
        +number matchScore
        +string[] matchReasons
    }

    class SpecFinderParams {
        +number tileWidth
        +number tileHeight
        +number? tileThickness
    }

    class ProjectService {
        -prisma: PrismaClient
        +getProjects(limit: int) ProjectWithImages[]
        +getProjectBySlug(slug: string) Project?
        +getProjectById(id: int) Project?
        -parseProjectImages(imagesStr: string?) string[]
    }

    class ProductService {
        -prisma: PrismaClient
        +getProducts(params: ProductFilterParams) ProductListResponse
        +findProductsBySpec(params: SpecFinderParams) SpecFinderResult[]
        +getProductBySku(sku: string) Product?
        +getFeaturedProducts(limit: int) Product[]
    }

    class SpecFinderService {
        -productService: ProductService
        +findMatches(params: SpecFinderParams) SpecFinderResult[]
        +getThicknessOptions() array
        +getSizePresets() array
    }

    %% Relationships
    ParentCategory "1" --> "0..*" SeriesInfo : parentSlug
    SeriesHelpers --> ParentCategory : looks up
    SeriesHelpers --> SeriesInfo : filters
    ParentCategoryViewProps --> SeriesHelpers : uses
    ParentCategoryView --> ParentCategoryViewProps : receives
    ProjectCardProps --> ProjectWithImages : renders
    ProjectCard --> ProjectCardProps : receives
    SpecFinderResult --> SpecFinderParams : matched from
    ProjectService --> ProjectWithImages : returns
    ProductService --> SpecFinderResult : returns
    SpecFinderService --> ProductService : delegates to
